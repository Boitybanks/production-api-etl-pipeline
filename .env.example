# Copy to .env for local runs. Never commit .env.

# Option 1: one connection URL (takes priority over the DB_* variables).
# Percent-encode special characters in the password, such as / @ and %.
# DATABASE_URL=postgresql://user:password@host:5432/crypto_etl?sslmode=require

# Option 2: individual settings. Only DB_PASSWORD is required.
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crypto_etl
DB_USER=postgres

# Optional CoinGecko demo API key, which reduces rate limiting.
# COINGECKO_API_KEY=
